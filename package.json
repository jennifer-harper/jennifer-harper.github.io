{
  "dependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
"scripts": {
  "tailwind": "tailwindcss -i ./src/input.css -o ./src/output.css --watch=always",
  "serve": "npx serve",
  "dev": "concurrently \"npm:tailwind\" \"npm:serve\""
}
}